{
	"semantic_tokens": "combined",
	"languages": {
		"PHP": {
			"language_servers": [
				"analyzer-lsp",
				"intelephense",
				"!phpactor",
				"!phpantom_lsp",
				"!phptools",
				"!prettier",
			],
			"format_on_save": "on",
			"formatter": {
				"external": {
					"command": "src/Scripts/format.php",
					"arguments": ["-"],
				},
			},
			"document_folding_ranges": "on",
			"document_symbols": "on",
			"inlay_hints": {
				"show_parameter_hints": true,
				"show_other_hints": true,
				"show_value_hints": true,
				"show_type_hints": true,
				"show_background": true,
				"enabled": false,
			},
		},
	},
	"lsp": {
		"analyzer-lsp": {
			"settings": {
				"configPath": "./analyzer-lsp.toml",
			},
		},
	},
}
