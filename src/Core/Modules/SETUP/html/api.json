{
    "openapi": "3.1.0",
    "info": {
        "title": "Nadybot setup API",
        "description": "This API provides access to Nadybot's setup functions in a REST API",
        "license": {
            "name": "GPL3",
            "url": "https://www.gnu.org/licenses/gpl-3.0.en.html"
        },
        "contact": {
            "name": "Support",
            "url": "https://discord.gg/aDR9UBxRfg"
        },
        "version": "7.0.0.alpha"
    },
    "servers": [
        {
            "url": "/"
        }
    ],
    "components": {
        "schemas": {
            "MemorySpecs": {
                "description": "Basic memory specs",
                "type": "object",
                "properties": {
                    "current_usage": {
                        "description": "Current memory usage in bytes",
                        "type": "integer",
                        "minimum": 1,
                        "example": 3128928
                    },
                    "current_usage_real": {
                        "description": "Current real memory usage in bytes",
                        "type": "integer",
                        "minimum": 1,
                        "example": 4194304
                    },
                    "peak_usage": {
                        "description": "Peak memory usage in bytes",
                        "minimum": 1,
                        "type": "integer",
                        "example": 3623516
                    },
                    "peak_usage_real": {
                        "description": "Peak real memory usage in bytes",
                        "minimum": 1,
                        "type": "integer",
                        "example": 6291456
                    },
                    "available": {
                        "description": "Available memory for PHP in bytes",
                        "minimum": 1,
                        "type": "integer",
                        "example": 134217728
                    }
                }
            },
            "Specs": {
                "type": "object",
                "properties": {
                    "bot_version": {
                        "description": "The full bot version",
                        "type": "string",
                        "minLength": 5,
                        "example": "7.0.0.alpha"
                    },
                    "php_version": {
                        "description": "The full PHP version",
                        "type": "string",
                        "minLength": 5,
                        "pattern": "^\\d+\\.\\d+\\.\\d+$",
                        "example": "8.1.17"
                    },
                    "os": {
                        "description": "The operating system type (Windows, Linux, Darwin, BSD, Solaris, Unknown, ...)",
                        "type": "string",
                        "example": "Linux"
                    },
                    "databases": {
                        "description": "The databases supported on this server",
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/DatabaseType"
                        },
                        "example": ["sqlite", "mysql"]
                    },
                    "memory": {
                        "$ref": "#/components/schemas/MemorySpecs"
                    }
                }
            },
            "CharacterName": {
                "description": "The character name",
                "example": "Nady",
                "type": "string",
                "pattern": "^[A-Z][a-z0-9]{3,}(-?\\d)?$",
                "minLength": 4,
                "maxLength": 12
            },
            "Password": {
                "type": "string",
                "minLength": 6,
                "maxLength": 20,
                "pattern": "^[a-zA-Z0-9-]{6,20}$"
            },
            "DatabaseType": {
                "type": "string",
                "enum": [
                    "sqlite",
                    "mysql",
                    "postgresql",
                    "mssql"
                ]
            },
            "Character": {
                "type": "object",
                "properties": {
                    "uid": {
                        "description": "The user id of this character",
                        "type": "integer",
                        "example": 1234567
                    },
                    "name": {
                        "description": "The character name",
                        "$ref": "#/components/schemas/CharacterName"
                    },
                    "online": {
                        "description": "Is this character already logged in?",
                        "type": "boolean",
                        "example": false
                    },
                    "level": {
                        "description": "The level of this character",
                        "type": "integer",
                        "example": 1,
                        "minimum": 1,
                        "maximum": 200
                    }
                },
                "description": "A single character from the login character list"
            },
            "AutoUnfreeze": {
                "type": "object",
                "properties": {
                    "enabled": {
                        "description": "Automatically try to unfreeze frozen accounts",
                        "type": "boolean",
                        "example": true
                    },
                    "useNadyproxy": {
                        "description": "If enabled, try to unfreeze a frozen account via a proxy to work around the limit of maximum of 3 unfreezings per IP address",
                        "example": false,
                        "type": "boolean"
                    }
                },
                "description": "Settings for the auto-unfreezer"
            },
            "BotConfig": {
                "type": "object",
                "properties": {
                    "autoUnfreeze": {
                        "oneOf": [
                            { "$ref": "#/components/schemas/AutoUnfreeze" },
                            { "type": "null" }
                        ]
                    },
                    "database": {
                        "$ref": "#/components/schemas/Database"
                    },
                    "general": {
                        "$ref": "#/components/schemas/General"
                    },
                    "main": {
                        "$ref": "#/components/schemas/Credentials"
                    },
                    "paths": {
                        "$ref": "#/components/schemas/Paths"
                    },
                    "proxy": {
                        "oneOf": [
                            { "type": "null" },
                            { "$ref": "#/components/schemas/Proxy" }
                        ]
                    },
                    "settings": {
                        "type": "object",
                        "additionalProperties": {
                            "type": [
                                "string",
                                "integer",
                                "boolean"
                            ]
                        },
                        "example": {
                            "console_color": true,
                            "webserver_addr": "0.0.0.0",
                            "webserver_auth": "aoauth"
                        },
                        "description": "Define settings values which will be immutable"
                    },
                    "worker": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Credentials"
                        },
                        "description": "Credentials of the worker characters"
                    }
                },
                "description": "The BotConfig class provides convenient interface for reading and saving config files located in conf-subdirectory."
            },
            "Credentials": {
                "type": "object",
                "properties": {
                    "character": {
                        "$ref": "#/components/schemas/CharacterName"
                    },
                    "dimension": {
                        "type": "integer",
                        "description": "Which dimension to login: 4 => Test, 5 => Rubi-Ka, 6 => RK19",
                        "minimum": 4,
                        "maximum": 6,
                        "example": 5
                    },
                    "login": {
                        "type": "string",
                        "minLength": 6,
                        "maxLength": 15
                    },
                    "password": {
                        "$ref": "#/components/schemas/Password"
                    },
                    "webLogin": {
                        "description": "The login credentials to use when unfreezing this character. Only set if different to the login",
                        "example": null,
                        "oneOf": [
                            {
                                "type": "string",
                                "minLength": 6,
                                "maxLength": 15
                            },
                            {"type": "null"}
                        ]
                    },
                    "webPassword": {
                        "description": "The password credentials to use when unfreezing this character. Only set if different to the password",
                        "example": null,
                        "oneOf": [
                            { "$ref": "#/components/schemas/Password" },
                            { "type": "null" }
                        ]
                    }
                },
                "description": "Credentials for a single character"
            },
            "Database": {
                "type": "object",
                "properties": {
                    "host": {
                        "type": "string",
                        "example": "./data/",
                        "description": "Hostname or sqlite file location"
                    },
                    "name": {
                        "type": "string",
                        "example": "nadybot.db",
                        "description": "Name of the database"
                    },
                    "password": {
                        "oneOf": [
                            {"type": "string"},
                            {"type": "null"}
                        ],
                        "description": "MySQL or PostgreSQL password, otherwise null",
                        "example": null
                    },
                    "type": {
                        "$ref": "#/components/schemas/DatabaseType",
                        "example": "sqlite",
                        "description": "What type of database should be used? ('sqlite', 'postgresql', or 'mysql')"
                    },
                    "username": {
                        "oneOf": [
                            { "type": "string" },
                            { "type": "null" }
                        ],
                        "example": null,
                        "description": "MySQL or PostgreSQL username, otherwise null"
                    }
                },
                "description": "The database configuration"
            },
            "General": {
                "type": "object",
                "properties": {
                    "autoOrgName": {
                        "type": "boolean",
                        "description": "Automatically rename the bot's org if it changed in-game",
                        "example": true
                    },
                    "defaultModuleStatus": {
                        "type": "integer",
                        "description": "Enable all current and upcoming modules (1) or only the bare minimum (0)",
                        "enum": [0, 1],
                        "example": 1
                    },
                    "enableConsoleClient": {
                        "type": "boolean",
                        "description": "Enable controlling the bot via the Linux console. Does not work on Windows.",
                        "example": true
                    },
                    "enableHydratorCache": {
                        "type": "boolean",
                        "description": "Speed up JSON parsing by compiling the schema. Uses more memory",
                        "example": true
                    },
                    "enablePackageModule": {
                        "type": "boolean",
                        "description": "Enable the `!package`-command",
                        "example": true
                    },
                    "orgName": {
                        "type": "string",
                        "description": "Name of the org the bot is a member of. Empty if none",
                        "example": "Nadybot Testers"
                    },
                    "showAomlMarkup": {
                        "type": "boolean",
                        "description": "Show raw AO-HTML data in logfiles, instead of converting it to ASCII",
                        "example": false
                    },
                    "superAdmins": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Character"
                        }
                    },
                    "timezone": {
                        "oneOf": [
                            {
                                "type": "string",
                                "description": "The timezone to use when displaying date and time.",
                                "example": "Europe/Amsterdam"
                            },
                            {"type": "null"}
                        ]
                    }
                },
                "description": "General config settings"
            },
            "Paths": {
                "type": "object",
                "properties": {
                    "cache": {
                        "type": "string",
                        "example": "./cache/",
                        "description": "Path to store cache files"
                    },
                    "data": {
                        "type": "string",
                        "example": "./data/",
                        "description": "Path to store data"
                    },
                    "html": {
                        "type": "string",
                        "example": "./html/",
                        "description": "Path to store HTML files"
                    },
                    "logs": {
                        "type": "string",
                        "example": "./logs/",
                        "description": "Path for the logs"
                    },
                    "modules": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "example": ["./src/Modules", "./extras"],
                        "description": "A list of paths where modules are"
                    }
                },
                "description": "Settings for the paths the bot uses"
            },
            "Proxy": {
                "type": "object",
                "properties": {
                    "enabled": {
                        "type": "boolean",
                        "example": false,
                        "description": "Whether to enable (true) proxy usage or not"
                    },
                    "port": {
                        "type": "integer",
                        "minimum": 1024,
                        "maximum": 65535,
                        "example": 9993,
                        "description": "Port of the proxy server"
                    },
                    "server": {
                        "type": "string",
                        "example": "127.0.0.1",
                        "description": "hostname or IP address of the proxy server"
                    }
                },
                "description": "Proxy settings (obsolete)"
            }
        }
    },
    "paths": {
        "/characters": {
            "get": {
                "operationId": "getCharacters",
                "security": [ ],
                "summary": "Get a list of all characters on a given account",
                "parameters": [
                    {
                        "name": "dimension",
                        "required": true,
                        "in": "query",
                        "schema": {
                            "type": "integer"
                        },
                        "description": "The dimension to login to"
                    },
                    {
                        "name": "login",
                        "required": true,
                        "in": "query",
                        "schema": {
                            "type": "string"
                        },
                        "description": "The username to use for login"
                    },
                    {
                        "name": "password",
                        "required": true,
                        "in": "query",
                        "schema": {
                            "type": "string"
                        },
                        "description": "The password to use for login"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "A list of characters on the given account",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Character"
                                    }
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Unknown dimension given",
                        "content": {
                            "text/html": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "408": {
                        "description": "Timeout getting list of characters",
                        "content": {
                            "text/html": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Error getting list of characters",
                        "content": {
                            "text/html": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Login or password invalid",
                        "content": {
                            "text/html": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid or missing parameter `dimension`, `login`, or `password`",
                        "content": {
                            "text/html": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/specs": {
            "get": {
                "operationId": "getSpecs",
                "security": [ ],
                "summary": "Get some basic specs of the server we're running on",
                "parameters": [ ],
                "responses": {
                    "200": {
                        "description": "Basic system specs",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Specs"
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "content": {
                            "text/html": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid or missing parameter `dimension`, `login`, or `password`",
                        "content": {
                            "text/html": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/config": {
            "post": {
                "operationId": "saveConfig",
                "security": [ ],
                "summary": "Save the given system configuration",
                "requestBody": {
                    "description": "The system configuration to save",
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/BotConfig"
                            }
                        }
                    }
                }
            },
            "parameters": []
        }
    }
}