{
	"name":"nadybot/nadybot",
	"description": "The successor of Budabot",
	"type":"project",
	"keywords": ["budabot", "nadybot"],
	"homepage": "https://github.com/nadybot/nadybot/",
	"authors": [
		{
			"name": "Nadyita",
			"email": "nadyita@hodorraid.org",
			"role": "Maintainer"
		},
		{
			"name": "Tyrence",
			"role": "Original Maintainer"
		}
	],

	"require": {
		"php": ">=8.1.17",
		"ext-sqlite3": "*",
		"ext-curl": "*",
		"ext-sockets": "*",
		"ext-pdo": "*",
		"ext-pdo_sqlite": "*",
		"ext-pdo_mysql": "*",
		"ext-mbstring": "*",
		"ext-ctype": "*",
		"ext-bcmath": "*",
		"ext-json": "*",
		"ext-simplexml": "*",
		"ext-filter": "*",
		"ext-pcre": "*",
		"ext-date": "*",
		"ext-reflection": "*",
		"ext-dom": "*",
		"revolt/event-loop": "^1.0.6",
		"illuminate/database": "^10.48.7",
		"kelvinmo/fernet-php": "^1.0",
		"farafiri/php-parsing-tool": "^2.0",
		"monolog/monolog": "^2.3",
		"thecodingmachine/safe": "^3.0",
		"psr/log": "^1|^2|^3",
		"amphp/amp": "^3.0.0",
		"amphp/http-client": "^5.0.1",
		"amphp/cache": "^2.0.0",
		"amphp/file": "^3.1.0",
		"amphp/websocket-client": "^2.0.0",
		"eventsauce/object-hydrator": "^1.1.0",
		"amphp/http-tunnel": "^2.0.0-beta.2",
		"nadylib/imex": "^1.0.4",
		"nadybot/aolib": "^0.1.7",
		"nadylib/leaky-bucket": "^0.1.0",
		"amphp/pipeline": "^1.2",
		"amphp/process": "^2.0",
		"amphp/byte-stream": "^2.1",
		"amphp/parallel": "^2.2",
		"amphp/http-server": "^3.3.0",
		"amphp/websocket-server": "^4.0.0",
		"doctrine/dbal": "^3",
		"ramsey/uuid": "^4.7",
		"nadybot/math-parser": "^1.4.1",
		"amphp/http-server-static-content": "^2.0",
		"amphp/http-server-router": "^2.0",
		"psr/simple-cache": "^3.0",
		"league/commonmark": "^2.8",
		"nadylib/type": "^0.1.0"
	},
	"autoload": {
		"psr-4": {
			"Nadybot\\User\\Modules\\": "extras/",
			"Nadybot\\": "src/",
			"Nadybot\\Tests\\": "tests/"
		}
	},
	"config": {
		"vendor-dir": "vendor",
		"allow-plugins": {
			"composer/package-versions-deprecated": true
		}
	},
	"require-dev": {
		"nadybot/nadystyle": "^1.0.0",
		"nadyita/phpstan-amp-file-rule": "^1.0.3",
		"squizlabs/php_codesniffer": "^3.9.0",
		"composer/composer": "^2.7.0",
		"phpstan/phpstan": "^2",
		"phpstan/phpstan-deprecation-rules": "^2.0",
		"composer-phar/php-cs-fixer": "^3.88.2",
		"vimeo/psalm": "^6",
		"thecodingmachine/phpstan-safe-rule": "^1.4",
		"struggle-for-php/sfp-phpstan-psr-log": "^1.0.0",
		"phpstan/phpstan-strict-rules": "^2.0",
		"shipmonk/phpstan-rules": "^2|^3|^4",
		"php-standard-library/phpstan-extension": "^2.0",
		"php-standard-library/psalm-plugin": "^2.3",
		"phpunit/phpunit": "^10",
		"carthage-software/mago": "1.29"
	},
	"scripts": {
		"post-package-install": [
			"Nadybot\\Patcher\\Patcher::patch"
		],
		"post-package-update": [
			"Nadybot\\Patcher\\Patcher::patch"
		],
		"test" : "./src/Scripts/tests.sh",
		"compile-ui" : "./src/Scripts/compile-ui.sh",
		"install-ui" : "./src/Scripts/compile-ui.sh install",
		"test-ui" : [
			"Composer\\Config::disableProcessTimeout",
			"cd nadyui && npm run build-dev"
		]
	}
}
